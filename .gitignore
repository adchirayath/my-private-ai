models/
weights/
checkpoints/
*.onnx
*.pt
*.pth
*.safetensors
*.bin
*.gguf
*.ggml

# ------------------------------------------------------------------------------
# 7. Vector Databases and RAG Storage
# ------------------------------------------------------------------------------
# ChromaDB persistence directory and embeddings
chroma_db/
# User uploaded documents and extracted files
uploads/**
!uploads/
!uploads/**/
!uploads/**/.gitkeep
# Local workspace runtime directory
workspace/**
!workspace/
!workspace/**/
!workspace/**/.gitkeep

# ------------------------------------------------------------------------------
# 8. Logs and Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tmp/
temp/
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
